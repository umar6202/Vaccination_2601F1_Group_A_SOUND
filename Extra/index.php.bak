<?php
require_once __DIR__ . '/includes/db.php';

$songs = [];
$videos = [];
$artists = [];
$playerSongs = [];

/* Latest five approved songs */
$songResult = mysqli_query($conn, "
    SELECT s.*, a.name AS artist_name, g.name AS genre_name
    FROM songs s
    LEFT JOIN artists a ON a.id = s.artist_id
    LEFT JOIN genres g ON g.id = s.genre_id
    WHERE s.status = 'approved'
    ORDER BY s.created_at DESC, s.id DESC
    LIMIT 5
");

if ($songResult) {
    while ($row = mysqli_fetch_assoc($songResult)) {
        $songs[] = $row;
    }
}

/* Latest five approved videos */
$videoResult = mysqli_query($conn, "
    SELECT v.*, a.name AS artist_name, g.name AS genre_name
    FROM videos v
    LEFT JOIN artists a ON a.id = v.artist_id
    LEFT JOIN genres g ON g.id = v.genre_id
    WHERE v.status = 'approved'
    ORDER BY v.created_at DESC, v.id DESC
    LIMIT 5
");

if ($videoResult) {
    while ($row = mysqli_fetch_assoc($videoResult)) {
        $videos[] = $row;
    }
}

/* Three tracks for the homepage player */
$playerResult = mysqli_query($conn, "
    SELECT s.*, a.name AS artist_name, g.name AS genre_name
    FROM songs s
    LEFT JOIN artists a ON a.id = s.artist_id
    LEFT JOIN genres g ON g.id = s.genre_id
    WHERE s.status = 'approved'
    ORDER BY s.created_at DESC, s.id DESC
    LIMIT 3
");

if ($playerResult) {
    while ($row = mysqli_fetch_assoc($playerResult)) {
        $playerSongs[] = $row;
    }
}

/* Featured artists: use the existing artists table */
$artistResult = mysqli_query($conn, "
    SELECT a.*, COUNT(s.id) AS release_count
    FROM artists a
    LEFT JOIN songs s
        ON s.artist_id = a.id AND s.status = 'approved'
    GROUP BY a.id
    ORDER BY release_count DESC, a.id DESC
    LIMIT 6
");

if ($artistResult) {
    while ($row = mysqli_fetch_assoc($artistResult)) {
        $artists[] = $row;
    }
}

/* Escape helper */
if (!function_exists('vebra_escape')) {
    function vebra_escape($value): string {
        return htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
    }
}

/* Resolve optional image/audio fields without assuming every field exists */
function vebra_field(array $row, array $keys, string $fallback = ''): string {
    foreach ($keys as $key) {
        if (isset($row[$key]) && trim((string)$row[$key]) !== '') {
            return trim((string)$row[$key]);
        }
    }
    return $fallback;
}

function vebra_image_path(string $path, string $fallback): string {
    $path = trim($path);
    if ($path === '') {
        return $fallback;
    }

    /* Allow remote URLs and local project-relative paths */
    if (preg_match('~^(https?://|/)~i', $path)) {
        return $path;
    }

    return $path;
}

