<?php
require_once __DIR__ . '/../includes/db.php';
if (session_status() === PHP_SESSION_NONE) {
    session_start();
}

$error = '';
$registeredMsg = isset($_GET['registered']) ? 'Registration successful! You can now log in.' : '';
$redirectUrl = isset($_GET['redirect']) ? $_GET['redirect'] : '../index.php';

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $loginIdentifier = trim($_POST['identifier'] ?? '');
    $password = $_POST['password'] ?? '';

    if (empty($loginIdentifier) || empty($password)) {
        $error = 'Please enter both your email/username and password.';
    } else {
        try {
            $stmt = $pdo->prepare("SELECT id, username, name, email, password, role FROM users WHERE email = ? OR username = ? LIMIT 1");
            $stmt->execute([$loginIdentifier, $loginIdentifier]);
            $user = $stmt->fetch(PDO::FETCH_ASSOC);

            if ($user && password_verify($password, $user['password'])) {
                $_SESSION['user_id'] = $user['id'];
                $_SESSION['username'] = $user['username'];
                $_SESSION['name'] = $user['name'];
                $_SESSION['role'] = $user['role'];

                if ($user['role'] === 'admin') {
                    header('Location: ../admin/index.php');
                } else {
                    header('Location: ' . $redirectUrl);
                }
                exit;
            } else {
                $error = 'Invalid email/username or password.';
            }
        } catch (Exception $e) {
            $error = 'A database error occurred. Please try again.';
        }
    }
}

$pageTitle = 'Log In — vebra';
$basePath = '../';
$bodyClass = 'theme-magenta';
$activePage = 'account';
$activeSub = 'login';
require_once __DIR__ . '/../includes/header.php';
?>

