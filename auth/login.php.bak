                        <i class="ri-checkbox-circle-fill" style="color:var(--accent); margin-right:6px;"></i> <?= htmlspecialchars($registeredMsg) ?>
                    </div>
                <?php endif; ?>

                <?php if ($error): ?>
                    <div style="background: rgba(255, 60, 60, 0.15); border: 1px solid rgba(255, 60, 60, 0.5); padding: 14px 18px; border-radius: 6px; margin-bottom: 24px; color: #fff; font-size: 0.95rem;">
                        <i class="ri-error-warning-fill" style="color:#ff5c5c; margin-right:6px;"></i> <?= htmlspecialchars($error) ?>
                    </div>
                <?php endif; ?>

                <form method="POST" action="" class="contact-form">
